---
import Layout from '../layouts/Layout.astro';
import DevToolLogo from '../components/DevToolLogo.astro';
import PostList from '../components/PostList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Tag from '../components/Tag.astro';
import { url } from '../config/site';
---

<Layout title="DianaSensei" description="Open-source developer tools and notes on building software.">
  <section class="max-w-3xl mx-auto px-4 pt-20 pb-12">
    <p id="greeting" class="text-sm text-slate-500 dark:text-slate-400 font-mono mb-5"></p>
    <h1 class="text-4xl sm:text-5xl font-medium text-slate-900 dark:text-white mb-4 leading-tight">
      Hi, I build developer tools.
    </h1>
    <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
      Mostly DevTool, a desktop app for the small jobs that come up every day. I also write about how it gets built.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-16">
    <SectionHeading>Projects</SectionHeading>
    <a
      href={url('/dev-tool')}
      class="group block border border-slate-200 dark:border-slate-800 rounded-2xl p-6 hover:border-brand-300 dark:hover:border-brand-700 hover:bg-brand-50/30 dark:hover:bg-brand-900/10 transition-all"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="flex items-center gap-4">
          <DevToolLogo size={44} class="rounded-xl shrink-0" />
          <div>
            <div class="flex items-baseline gap-3">
              <p class="text-xl font-semibold text-slate-900 dark:text-white">DevTool</p>
              <span data-latest-version class="text-sm text-brand-600 dark:text-brand-400 font-mono opacity-0 transition-opacity duration-200"></span>
            </div>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Desktop app · macOS · Windows · Linux</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-brand-500 transition-colors mt-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
        JSON and SQL formatting, an API client and mock server, JWT, regex, hashing, time tracking,
        and more. Runs on your machine. No account, no telemetry.
      </p>
      <div class="flex flex-wrap gap-2">
        {['MIT', 'open source', 'offline'].map((t) => <Tag>{t}</Tag>)}
      </div>
    </a>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-16">
    <div class="flex items-center justify-between mb-6">
      <SectionHeading class="">Latest posts</SectionHeading>
      <a href={url('/blog')} class="text-xs text-brand-600 dark:text-brand-400 hover:underline">All posts →</a>
    </div>
    <PostList limit={3} />
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-20">
    <SectionHeading>About</SectionHeading>
    <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
      I care about open source and about software that keeps working. When I design a system I plan
      for scale and for failure from the start, lean on well-known patterns, and assume zero trust.
      The goal is code that other people can read, maintain, and rely on.
    </p>
  </section>
</Layout>

<script>
  import { fetchLatestVersion } from '../lib/release';

  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
  const greetingEl = document.getElementById('greeting');
  if (greetingEl) greetingEl.textContent = `${greeting}.`;

  fetchLatestVersion().then((version) => {
    const versionEl = document.querySelector<HTMLElement>('[data-latest-version]');
    if (version && versionEl) {
      versionEl.textContent = `v${version}`;
      versionEl.classList.remove('opacity-0');
    }
  });
</script>
