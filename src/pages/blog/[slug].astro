---
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';
import { APP_REPO_URL, url } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} — DevTool Blog`} description={post.data.description}>
  <div class="max-w-2xl mx-auto px-4 pt-12 pb-20">
    <a href={url('/blog')} class="inline-flex items-center gap-1 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 mb-8 transition-colors">
      ← All posts
    </a>

    <header class="mb-10">
      <div class="flex flex-wrap gap-1 mb-4">
        {post.data.tags.map((tag) => <Tag variant="brand">{tag}</Tag>)}
      </div>
      <h1 class="text-3xl font-medium text-slate-900 dark:text-white mb-3 leading-snug">{post.data.title}</h1>
      <p class="text-slate-500 dark:text-slate-400 mb-4">{post.data.description}</p>
      <time class="text-sm text-slate-400 dark:text-slate-500">
        {formatDate(post.data.pubDate)}
      </time>
    </header>

    <hr class="border-slate-200 dark:border-slate-800 mb-10" />

    <div class="prose-blog">
      <Content />
    </div>

    <hr class="border-slate-200 dark:border-slate-800 mt-14 mb-8" />

    <div class="flex items-center justify-between">
      <a href={url('/blog')} class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">← All posts</a>
      <a
        href={APP_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        Star on GitHub →
      </a>
    </div>
  </div>
</Layout>
