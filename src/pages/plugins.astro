---
import Layout from '../layouts/Layout.astro';
import Tag from '../components/Tag.astro';
import { plugins } from '../data/plugins';
import { LATEST_RELEASE_URL, PLUGIN_REPO, PLUGIN_REPO_URL, url } from '../config/site';

const secondaryButton =
  'copy-btn text-xs px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-600 transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
const mutedLink = 'underline hover:text-slate-600 dark:hover:text-slate-300';
---

<Layout
  title="Plugins — DevTool"
  description="Optional DevTool plugins: Redis, RabbitMQ, containers, and Kafka. Install them from Settings → Extensions."
>
  <div class="max-w-5xl mx-auto px-4 pt-14 pb-20">
    <h1 class="text-3xl font-medium text-slate-900 dark:text-white mb-2">Plugins</h1>
    <p class="text-slate-500 dark:text-slate-400 mb-2 max-w-2xl">
      Not everyone needs a Redis client or a container manager, so these tools are optional.
      Install the ones you use from
      <span class="font-medium text-slate-700 dark:text-slate-300">Settings → Extensions</span>
      in DevTool.
    </p>
    <p class="text-sm text-slate-400 dark:text-slate-500 mb-2">
      Had these built in before? Read <a href={url('/plugin-migration')} class={mutedLink}>what changed</a>.
    </p>
    <p class="text-sm text-slate-400 dark:text-slate-500 mb-2">
      Source: <a href={PLUGIN_REPO_URL} target="_blank" rel="noopener noreferrer" class={mutedLink}>{PLUGIN_REPO}</a>
      <span id="catalog-status" class="ml-2"></span>
    </p>
    <p class="text-sm text-slate-400 dark:text-slate-500 mb-10">
      Don't have DevTool yet?
      <a href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer" class={mutedLink}>Download it first</a>.
      The Install button opens the app.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {plugins.map((p) => (
        <div class="border border-slate-200 dark:border-slate-800 rounded-xl p-5 bg-white dark:bg-slate-900/30" data-plugin-id={p.id}>
          <div class="flex items-start justify-between gap-2 mb-2">
            <p class="font-medium text-slate-900 dark:text-white">{p.label}</p>
            <span data-version><Tag>loading…</Tag></span>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-3">{p.description}</p>
          <div class="flex flex-wrap gap-1 mb-4">{p.keywords.map((k) => <Tag>{k}</Tag>)}</div>
          <div class="flex flex-wrap gap-2 mb-2">
            <a
              data-install
              aria-disabled="true"
              class="text-xs px-3 py-1.5 rounded-lg transition-colors bg-slate-300 dark:bg-slate-700 text-slate-500 dark:text-slate-400 cursor-not-allowed pointer-events-none aria-[disabled=false]:bg-slate-900 aria-[disabled=false]:dark:bg-white aria-[disabled=false]:text-white aria-[disabled=false]:dark:text-slate-900 aria-[disabled=false]:cursor-pointer aria-[disabled=false]:pointer-events-auto aria-[disabled=false]:hover:opacity-90"
            >
              Install in DevTool
            </a>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class={secondaryButton} data-copy="pluginManifestUrl" disabled>Copy plugin manifest URL</button>
            <button type="button" class={secondaryButton} data-copy="serviceManifestUrl" disabled>Copy sidecar manifest URL</button>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 border border-slate-200 dark:border-slate-800 rounded-xl p-5 bg-white dark:bg-slate-900/30 max-w-2xl">
      <p class="font-medium text-slate-900 dark:text-white mb-2">How to install</p>
      <ol class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed list-decimal list-inside space-y-1">
        <li>Install DevTool if you haven't yet.</li>
        <li>Click <span class="font-medium text-slate-700 dark:text-slate-300">Install in DevTool</span>. The app opens at Settings → Extensions with the plugin (and its sidecar, if any) ready to install.</li>
        <li>Check the permissions it asks for, then click Install. Nothing is installed until you confirm.</li>
        <li>Restart DevTool. The plugin loads on the next launch.</li>
      </ol>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-3">
        If the link doesn't open DevTool, copy the manifest URLs and paste them into Settings → Extensions.
      </p>
    </div>
  </div>
</Layout>

<script>
  import { loadCatalog, installLink, type CatalogEntry } from '../lib/catalog';

  async function copy(button: HTMLButtonElement, text: string) {
    try {
      await navigator.clipboard.writeText(text);
      const original = button.textContent;
      button.textContent = 'Copied!';
      setTimeout(() => (button.textContent = original), 1500);
    } catch {
      // Clipboard access can be denied; the URL is still in the catalog.
    }
  }

  function applyEntry(card: HTMLElement, entry: CatalogEntry) {
    const version = card.querySelector('[data-version] span');
    if (version) version.textContent = `v${entry.version}`;

    for (const button of card.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
      const value = entry[button.dataset.copy as 'pluginManifestUrl' | 'serviceManifestUrl'];
      if (!value) continue;
      button.disabled = false;
      button.addEventListener('click', () => copy(button, value));
    }

    const link = card.querySelector<HTMLAnchorElement>('a[data-install]');
    if (link && entry.pluginManifestUrl) {
      link.href = installLink(entry);
      link.setAttribute('aria-disabled', 'false');
    }
  }

  const status = document.getElementById('catalog-status');

  loadCatalog()
    .then((catalog) => {
      for (const entry of catalog.plugins) {
        const card = document.querySelector<HTMLElement>(`[data-plugin-id="${CSS.escape(entry.id)}"]`);
        if (card) applyEntry(card, entry);
      }
      if (status) status.textContent = `· catalog v${catalog.version}`;
    })
    .catch(() => {
      if (status) status.textContent = '· catalog unavailable, showing known plugins only';
      document.querySelectorAll('[data-version]').forEach((el) => el.remove());
    });
</script>
