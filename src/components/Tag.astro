---
interface Props {
  variant?: 'neutral' | 'brand';
}

const { variant = 'neutral' } = Astro.props;

const styles = {
  neutral: 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400',
  brand:
    'bg-brand-50 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 border border-brand-200 dark:border-brand-800',
};
---

<span class={`text-xs px-2 py-0.5 rounded-full whitespace-nowrap ${styles[variant]}`}><slot /></span>
