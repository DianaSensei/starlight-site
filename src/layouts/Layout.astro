---
import '../styles/global.css';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import { APP_REPO_URL, ISSUES_URL, NAV_LINKS, RELEASES_URL, url } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'DevTool: everyday developer tools in one offline desktop app.',
  ogImage,
} = Astro.props;

const iconButton =
  'w-8 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors';
const textLink = 'hover:text-slate-900 dark:hover:text-white transition-colors';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>

    <!-- Runs before paint so the page never flashes the wrong theme. -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const dark = stored ? stored === 'dark' : prefersDark;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center gap-6">
        <a href={url('/')} class="flex items-center gap-2 font-medium text-slate-900 dark:text-white" aria-label="Home">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </a>

        <nav class="flex items-center gap-5 ml-4 text-sm text-slate-600 dark:text-slate-400">
          {NAV_LINKS.map((link) => <a href={url(link.href)} class={textLink}>{link.label}</a>)}
        </nav>

        <div class="ml-auto flex items-center gap-3">
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class={iconButton}>
            <svg class="hidden dark:block w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <svg class="block dark:hidden w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>

          <a href={APP_REPO_URL} target="_blank" rel="noopener noreferrer" class={iconButton} aria-label="GitHub repository">
            <GitHubIcon />
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800 mt-20">
      <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500 dark:text-slate-400">
        <p>Open source · MIT License</p>
        <div class="flex gap-4">
          <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class={textLink}>Releases</a>
          <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" class={textLink}>Issues</a>
        </div>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
